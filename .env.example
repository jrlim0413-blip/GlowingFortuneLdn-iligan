# Vercel Environment Variables Configuration
# Copy this to .env or configure directly in your Vercel Project Settings

# API Endpoints
VITE_API_URL=https://stl-ldn-api.com/api/accountant/TellerGrossPerDay?id=5
VITE_DRAW_API_URL=https://stl-ldn-api.com/api/accountant/GrossPerDraw?id=5
VITE_OVERALL_API_URL=https://stl-ldn-api.com/api/accountant/OverAllReports?id=5
VITE_SUPERVISOR_API_URL=https://stl-ldn-api.com/api/accountant/AccountantSpvrWithGross?id=5
VITE_LOGIN_API_URL=https://stl-ldn-api.com/api/accountant/login

# Draw Configuration
VITE_DRAW_IDS=248,249,250,251,252,253

# Authentication Token & Branch Configuration
VITE_AUTHORIZATION=your_bearer_token_here
VITE_BRANCH_NAME=Iligan

# Supabase Credentials (Required for RBAC & Cloud Database persistence)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
